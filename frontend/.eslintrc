{
  "plugins": ["jsdoc"],
  "rules": {
    // 🚫 Catch obvious useless comments
    "no-warning-comments": ["warn", {
      "terms": ["todo", "fixme"],
      "location": "anywhere"
    }],

    // ⚠️ Discourage empty/useless comments
    "spaced-comment": ["warn", "always", {
      "markers": ["/"],
      "exceptions": ["-"]
    }],

    // 🚫 Catch commented-out code (huge win)
    "no-unused-vars": "warn",

    // ⚠️ Encourage meaningful comments (light touch)
    "jsdoc/require-description": "off",
    "jsdoc/check-tag-names": "off"
  }
}
