{
  "name": "luma-frontend",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run ui:test",
    "ui:test": "playwright test --config=playwright.config.js --project app --project import --project marketplace",
    "ui:smoke": "playwright test --config=playwright.smoke.config.js",
    "ui:test:a11y": "playwright test --config=playwright.config.js --project a11y --no-deps",
    "ui:test:all": "playwright test --config=playwright.config.js",
    "ui:test:headed": "playwright test --config=playwright.config.js --project app --project import --project marketplace --headed",
    "ui:test:debug": "playwright test --config=playwright.config.js --debug",
    "ui:test:file": "playwright test --config=playwright.config.js",
    "ui:codegen": "node scripts/runPlaywrightCodegen.js",
    "lint": "npm run lint:frontend && npm run lint:backend && npm run lint:ruff && npm run lint:timestamps && npm run lint:personal-data && npm run lint:shipped-ascii",
    "lint:frontend": "eslint . && node scripts/check-comments.js",
    "lint:backend": "node ../scripts/run_backend_comment_check.js",
    "lint:ruff": "node ../scripts/run_ruff.js",
    "lint:timestamps": "node ../scripts/check-backend-timestamps.js",
    "lint:personal-data": "node ../scripts/check-personal-data.js",
    "lint:shipped-ascii": "node ../scripts/run_shipped_ascii_check.js",
    "postinstall": "bash ../scripts/install-hooks.sh || sh ../scripts/install-hooks.sh"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.6",
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^65.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react-test-renderer": "^18.3.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
