{
  "name": "fintrack-frontend",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ui:test": "playwright test --config=playwright.config.js",
    "ui:test:headed": "playwright test --config=playwright.config.js --headed",
    "ui:test:debug": "playwright test --config=playwright.config.js --debug",
    "ui:test:file": "playwright test --config=playwright.config.js",
    "ui:codegen": "node scripts/runPlaywrightCodegen.js",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "eslint . && node scripts/check-comments.js",
    "lint:backend": "node ../scripts/run_backend_comment_check.js",
    "postinstall": "bash ../scripts/install-hooks.sh || sh ../scripts/install-hooks.sh"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react-test-renderer": "^18.3.1",
    "vite": "^5.4.1",
    "vitest": "^2.1.9"
  }
}
