# ── Working storage ──────────────────────────────────────────────────────────
# Local storage for files not to be committed (eg. db backups, private
# keys, test scripts). The app never writes here; a developer tool may create it
# (scripts/refresh-personal-data-terms.py keeps its term list in data/).
data/

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env-*
*.env.local

# ── Databases ────────────────────────────────────────────────────────────────
# Your personal financial data — never commit these
*.db
*.db-shm
*.db-wal
*.db-journal

# ── Database Backups ─────────────────────────────────────────────────────────
# Your personal financial data — never commit these
luma_backup.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Node / Frontend ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/playwright-report/
frontend/test-results/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/


# Playwright E2E throwaway backend stack (temp DBs)
backend/.e2e-tmp/
