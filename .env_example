# FinTrack environment configuration
# Copy this file to .env and fill in your values:
#   cp .env_example .env

# ------------------------------------------------------------------------------
# 1. First-run settings most users should review
# ------------------------------------------------------------------------------

# Required. Change this to a long random string before running in production.
# Used to sign session cookies. Changing it invalidates all active sessions.
SESSION_SECRET=change_me_to_a_long_random_value

# Strongly recommended if you plan to use Plaid or any other stored secrets.
# Base64-encoded 32-byte key for encrypting Plaid access tokens at rest.
# Generate one with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If unset, FinTrack derives a fallback key from SESSION_SECRET.
# Set this before linking any bank accounts for best security.
APP_MASTER_KEY=

# ------------------------------------------------------------------------------
# 2. Optional Plaid setup
#    Ignore this section if you only want CSV import.
# ------------------------------------------------------------------------------

# Sign up free at https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here

# Plaid environment - controls which Plaid API servers are used:
#   sandbox     - fake bank accounts, no real data, good for development
#   development - real accounts, limited to 100 Items, no Plaid approval needed
#   production  - full live access, requires Plaid approval
PLAID_ENV=sandbox

# ------------------------------------------------------------------------------
# 3. Optional advanced settings
#    Most users can ignore everything below this line.
# ------------------------------------------------------------------------------

# -- Session/browser isolation -------------------------------------------------
# Give each local instance a unique cookie name if you run multiple copies on
# the same host in the same browser.
# Default: session
SESSION_COOKIE_NAME=session

# -- Data path overrides -------------------------------------------------------
# Path to the control database (stores users, not financial data).
# Default: fintrack-control.db in the working directory.
CONTROL_DB_PATH=fintrack-control.db

# Root directory for per-user financial databases.
# Each user gets their own SQLite file under this directory.
# Default: data/
TENANT_DATA_ROOT=data

# Path to the single-user SQLite database.
# Only used when auth is disabled (local/single-user mode).
# When running via Docker, this is set to /data/fintrack-data.db via docker-compose.yml.
# DB_PATH=fintrack-data.db

# -- Local dev / multi-instance wiring ----------------------------------------
# Override these when running two separate FinTrack checkouts side by side.
# Frontend dev server port (Vite). Default: 5173
FRONTEND_PORT=5173

# Backend API port for local dev commands such as uvicorn. Default: 8000
# If you change this, also start uvicorn with the same port number.
BACKEND_PORT=8000

# Optional override. If blank/unset, FinTrack derives this from BACKEND_PORT.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Optional override. If blank/unset, FinTrack derives this from FRONTEND_PORT
# and FRONTEND_DOCKER_PORT.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Docker-published frontend port. Default: 3000
FRONTEND_DOCKER_PORT=3000

# ------------------------------------------------------------------------------
# 4. FinTrack-specific operational toggles
#    These are app-specific runtime knobs. Most users can ignore them.
# ------------------------------------------------------------------------------

# Write fresh backend/frontend launcher logs on each start.
# Set to false if you do not want scripts/backend.log and scripts/frontend.log.
FINTRACK_USE_LOG_FILES=false

# How long the launcher should wait for the backend health check before starting
# the frontend anyway. Increase this if first-run dependency installation is slow.
FINTRACK_BACKEND_READY_TIMEOUT=180

# Experimental security/settings UI. Leave false to hide Security model and
# pre-auth Sign-in protection from Settings until that work is ready.
# If sign-in protection is already enabled, those sections will still appear.
# FINTRACK_EXPERIMENTAL_SECURITY_SETTINGS=true

# Make developer-only options visible in Settings. Intended for local development
# and testing workflows.
# FINTRACK_DEVELOPER_OPTIONS=true
