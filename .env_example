# Optional Luma configuration overrides
#
# No .env file is required, this file supports some special configurations.
#   cp .env_example .env
#
# An override takes effect at the next restart. Settings → Configuration
# shows every effective value and where it came from.
#
# One variable cannot be set here, since it selects which file is read: LUMA_ENV_FILE points the backend
# at a different file entirely. It is set in the environment before starting the backend, and it redirects
# the backend only -- the launcher scripts and the frontend dev server read this file directly for their
# ports, so it isolates databases rather than switching between whole configurations. The Playwright
# harness uses it to run against throwaway databases.

# ------------------------------------------------------------------------------
# 1. Running more than one installation on one machine, 
#    the most common reason to have this file.
# ------------------------------------------------------------------------------

# DATA_DIR identifies where the databases live, luma-data.db and luma-control.db
# sit in this directory.
# When running via Docker this is set to /data by docker-compose.yml.
# Default: current working directory
# DATA_DIR=.

# CONTROL_DB_PATH and DB_PATH name a single database file each, and win over DATA_DIR
# for that file. Needed only where a database does not use the default filename, which
# includes installs predating DATA_DIR; new setups want DATA_DIR instead.

# Ports
# Defaults: 5173/8000
# FRONTEND_PORT=5173
# BACKEND_PORT=8000

# Address the development frontend listens on. Loopback by default, so it is not reachable
# from other devices. Set 0.0.0.0 to test from a phone or another machine on the network.
# Default: localhost
# FRONTEND_HOST=0.0.0.0

# Tags browser sessions to keep them separate when two installations are used from the
# same browser.
# Default: Derived from the control database path on first run and then stored
# SESSION_COOKIE_NAME=

# ------------------------------------------------------------------------------
# 2. Deployment
# ------------------------------------------------------------------------------

# Signs session cookies. Generated on first run and stored in the control database; set it here only
# to pin a specific value (for example, to keep sessions valid across a rebuilt control database).
# Changing it signs everyone out.
# SESSION_SECRET=

# Mark the session cookie Secure (only sent over HTTPS). Left false for the loopback/desktop default
# (plain HTTP on 127.0.0.1). Set true for a client-server install behind a TLS-terminating reverse
# proxy, where the cookie must never cross the network in cleartext. Default: false
# SESSION_COOKIE_SECURE=false

# Other web origins whose pages may call this API from a browser, with cookies attached. Empty by
# default — the app and the API are served on one origin (both the dev server and the Docker frontend
# proxy /api), so no grant is needed. Set this only for a split-origin deployment.
# CORS_ORIGINS=https://app.example.invalid

# Docker-published frontend port. Default: 3000
# FRONTEND_DOCKER_PORT=3000

# Optional override for the Vite dev proxy. Derived from BACKEND_PORT when unset.
# VITE_API_PROXY_TARGET=http://localhost:8000

# Display name, for white-labelling. Mirrors the frontend's build-time VITE_APP_NAME. Default: Luma
# APP_NAME=Luma

# ------------------------------------------------------------------------------
# 3. Launcher and developer options
# ------------------------------------------------------------------------------

# Write backend/frontend launcher logs on each start.
# Default: false
# LUMA_USE_LOG_FILES=false

# How long the launcher waits for the backend health check before starting the frontend anyway.
# Increase this if first-run dependency installation is slow. Default: 180
# LUMA_BACKEND_READY_TIMEOUT=180

# Make developer-only options visible in Settings, including destructive reset tools. 
# A gate on semi-dangerous tooling not needed for normal usage.
# LUMA_DEVELOPER_OPTIONS=true
